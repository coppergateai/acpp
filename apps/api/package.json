{
  "name": "@acpp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "dev": "node --import tsx --watch src/serve.ts"
  },
  "dependencies": {
    "@acpp/core": "workspace:*",
    "@acpp/discovery": "workspace:*",
    "@acpp/mcp": "workspace:*",
    "@acpp/schemas": "workspace:*",
    "@acpp/github": "workspace:*",
    "@acpp/db": "workspace:*",
    "@acpp/identity": "workspace:*",
    "@acpp/policy": "workspace:*",
    "@acpp/receipts": "workspace:*",
    "@acpp/signals": "workspace:*"
  },
  "devDependencies": {
    "@acpp/typescript-config": "workspace:*",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
