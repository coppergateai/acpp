  },
  "devDependencies": {
    "@acpp/core": "workspace:*",
    "@acpp/typescript-config": "workspace:*",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
