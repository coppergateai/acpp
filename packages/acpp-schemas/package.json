{
  "name": "@acpp/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi/acpp-hosted-v1.openapi.json": "./openapi/acpp-hosted-v1.openapi.json",
    "./protocol/v0.1.0/*": "./protocol/v0.1.0/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
