{
  "name": "@acpp/mcp-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "acpp-mcp-host": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "start": "node --import tsx src/cli.ts",
    "start:dist": "node dist/cli.js",
    "bootstrap": "node --import tsx src/bootstrap-cli.ts"
  },
  "dependencies": {
    "@acpp/api": "workspace:*",
    "@acpp/core": "workspace:*",
    "@acpp/identity": "workspace:*",
    "@acpp/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@acpp/typescript-config": "workspace:*",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
